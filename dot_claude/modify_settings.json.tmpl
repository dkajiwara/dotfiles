#!/bin/bash
# chezmoi passes the current ~/.claude/settings.json content on stdin;
# stdout becomes the new content.
#
# Base content (everything chezmoi owns) lives in settings.base.json.
# advisorModel is passed through as-is from the live file, since Claude Code
# itself writes it via /config. model works the same way, except the base value
# is kept as the fallback so a fresh machine still starts from a known model.
#
# enabledPlugins is a merge, not a passthrough: the base holds the plugins that
# should exist on every machine (skills/agents/commands only — nothing needing
# per-machine setup), and the live value wins per key, so enabling or disabling
# a plugin from /plugin is never reverted by the next apply. Machine-specific
# plugins (figma, chrome-devtools-mcp, the LSP ones) stay out of the base and
# just ride along from the live file.
#
# Everything else always comes from the base.

set -euo pipefail

base="{{ .chezmoi.sourceDir }}/dot_claude/settings.base.json"

# env.PATH is machine-dependent (home dir), so it is assembled here at apply
# time instead of being hardcoded in settings.base.json.
claude_path="$HOME/.local/share/mise/shims"
claude_path="$claude_path:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
claude_path="$claude_path:$HOME/.cargo/bin:$HOME/.pub-cache/bin:$HOME/.local/bin:$HOME/go/bin"
claude_path="$claude_path:$HOME/Library/Android/sdk/platform-tools:$HOME/google-cloud-sdk/bin"
claude_path="$claude_path:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
claude_path="$claude_path:/opt/homebrew/opt/fzf/bin"

jq --slurp --slurpfile base "$base" --arg path "$claude_path" '
  ($base[0]) as $base |
  (.[0] // {}) as $live |
  ($base + {
    enabledPlugins: (($base.enabledPlugins // {}) + ($live.enabledPlugins // {})),
    model: ($live.model // $base.model),
    advisorModel: $live.advisorModel
  }) |
  .env.PATH = $path |
  if .advisorModel == null then del(.advisorModel) else . end
'
